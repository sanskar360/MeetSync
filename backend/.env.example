DATABASE_URL=postgresql://postgres:password@localhost:5432/meetsync
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
TOKEN_ENCRYPTION_KEY=your-32-byte-base64-encryption-key
GOOGLE_WEBHOOK_URL=https://your-public-domain.ngrok-free.app/api/webhooks/google-calendar

# Google Calendar Watch Renewal Settings
GOOGLE_WATCH_RENEWAL_BUFFER_HOURS=24
GOOGLE_WATCH_RENEWAL_INTERVAL_SECONDS=3600
ENABLE_BACKGROUND_WATCH_SCHEDULER=true

# Phase 2: Authentication & Storage
JWT_SECRET_KEY=generate-a-strong-32-char-random-secret-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_TRANSCRIPT_FILE_SIZE_BYTES=26214400
TRANSCRIPT_MIN_WORD_COUNT=25
TRANSCRIPT_STORAGE_BACKEND=local
TRANSCRIPT_STORAGE_DIR=storage/transcripts